{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-sar.local/schemas/assistant-response.schema.json",
  "title": "AssistantResponse",
  "description": "Response from the owner AI model (through the gateway) to the web app. Contract version 1.x. Semantic rules beyond this schema (see README): status ok requires an answer and at least one citation, and every citation id must exist in the request context.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status"],
  "properties": {
    "version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "status": { "enum": ["ok", "error", "unavailable"] },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "format"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 20000, "description": "Inline citation markers look like [[citation_id]]." },
        "format": { "enum": ["markdown", "plain"] }
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._:/#-]{1,200}$", "description": "Must equal a citation_id present in the request context." },
          "type": { "enum": ["observation", "derived", "reference"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 400 },
          "granule": { "type": "string", "maxLength": 300 },
          "url": { "type": "string", "maxLength": 1000, "pattern": "^https?://" },
          "layer_id": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "limitations": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 1000 } },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
