# Template only. The gateway reads process.env, not this file: export these in your shell.
# Never commit real values.

# Where YOUR model listens. Unset = gateway reports "unavailable" and the UI shows "Assistant not connected".
ASSISTANT_MODEL_URL=
# Optional bearer token sent to the model as "Authorization: Bearer <key>". Stays server-side.
ASSISTANT_MODEL_API_KEY=
# Max wait for the model, in milliseconds.
ASSISTANT_TIMEOUT_MS=30000
# Comma-separated browser origins allowed to call the gateway, e.g. http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Requests per minute per client IP.
RATE_LIMIT_PER_MIN=30

# Optional
PORT=8787
HOST=127.0.0.1
MAX_BODY_BYTES=262144
# Set to 1 only behind a trusted reverse proxy so X-Forwarded-For is used for rate limiting.
TRUST_PROXY=0
# Set to 1 to log rejection reasons (never bodies or keys).
LOG_REQUESTS=0
